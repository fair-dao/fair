@inherits UIBase
<div class="fairdao-page-message">
    @ChildContent
    @if (Empty)
    {
        @Localer["什么也没有发现，过一会儿再试吧"]
    }
    else if (RecordNotFound){
        @Localer["没有找到相关信息"]
    }
</div>

@code {


    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool Empty { get; set; } = false;


    [Parameter]
    public bool RecordNotFound { get; set; } = false;



}
