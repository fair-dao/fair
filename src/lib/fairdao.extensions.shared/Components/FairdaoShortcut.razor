@if (!string.IsNullOrEmpty(Link))
{
    <a href="@Link" class="fairdao-shortcut">
        <div class="fairdao-shortcut-ico">
            <FluentIcon Value="Icon"></FluentIcon>
        </div>
        <div class="fairdao-shortcut-text">
            @Text
        </div>
    </a>
}else{
    <div class="fairdao-shortcut" @onclick="()=> OnClick.InvokeAsync()">
        <div class="fairdao-shortcut-ico">
            <FluentIcon Value="Icon"></FluentIcon>
        </div>
        <div class="fairdao-shortcut-text">
            @Text
        </div>
    </div>
}

@code {
    [Parameter]
    public Icon Icon { get; set; }

    [Parameter]
    public string Text { get; set; }

    [Parameter]
    public string Link { get; set; }


    [Parameter]
    public EventCallback OnClick{ get; set; }

    protected override void OnInitialized()
    {
       
        base.OnInitialized();
    }


}
