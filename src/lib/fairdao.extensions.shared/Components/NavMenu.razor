@inherits ComBase
<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Fill" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        @if (sidebarMenus != null)
        {

            <FluentNavMenu Id="main-menu" Width="250" Collapsible="true" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
                @foreach (var m in sidebarMenus)
                {

                    @if (m.SubCommpents != null && m.SubCommpents.Count > 0)
                    {
                        <FluentNavGroup Expanded="m.Expand" Title="@Localer[m.Text]" Icon="m.Icon">
                            @foreach (var subMenu in m.SubCommpents)
                            {
                            if (string.IsNullOrEmpty(subMenu.Link) && subMenu.SubCommpents?.Count > 0)
                                {
                                    <FluentNavGroup Expanded="subMenu.Expand" Title="@subMenu.Text" Icon="subMenu.Icon" IconColor="Color.Accent">
                                        @foreach (var subMenu2 in subMenu.SubCommpents)
                                        {
                                            <FluentNavLink Href="@GetLinkUrl(subMenu2)" Icon="subMenu2.Icon" IconColor="Color.Accent">@Localer[subMenu2.Text]</FluentNavLink>
                                        }
                                    </FluentNavGroup>
                                }
                                else
                                {
                                    <FluentNavLink Href="@GetLinkUrl(subMenu)" Icon="subMenu.Icon" IconColor="Color.Accent">@Localer[subMenu.Text]</FluentNavLink>
                                }
                            }
                        </FluentNavGroup>
                    }
                    else
                    {
                        <FluentNavLink Href="@GetLinkUrl(m)" Icon="m.Icon" IconColor="Color.Accent">@Localer[m.Text]</FluentNavLink>
                    }
                }

            </FluentNavMenu>

        }
    </nav>
</div>

@code {

    private bool expanded = true;
    private List<fairdao.extensions.shared.entity.VCommpent> sidebarMenus = null;

    protected override async Task OnInitializedAsync()
    {
        sysHelper.ConfigChanged += new SysHelper.ConfigChangedHandler(ConfigChanged);

        ConfigChanged();
    }


    void ConfigChanged()
    {
        sidebarMenus = sysHelper.ClientConfig?.Sides;
        this.InvokeAsync(() => StateHasChanged());
    }
    public void Dispose()
    {
        sysHelper.ConfigChanged -= new SysHelper.ConfigChangedHandler(ConfigChanged);
    }

}
