@namespace fairdao.extensions.shared.Pages
@inherits fairdao.extensions.shared.Pages.Page

<FairdaoPage ContentPadding>
    <TitlePanel>
        @Localer["外观设置"]
    </TitlePanel>
    <ContentPanel>
      
            <FluentDesignTheme @ref=_theme
                               @bind-Mode="@Mode"
                               @bind-OfficeColor="@OfficeColor"
                               Direction="@Direction"
                               StorageName="theme" />

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <FluentSelect Label="@Localer["主题"]"
                              Width="100%"
                              Style="margin-bottom: 30px;"
                              Items="@AllModes"
                              OptionText="@(p =>GetModeName(p))"
                              @bind-SelectedOption="@Mode" />

                <FluentSelect Label="@Localer["颜色"]"
                              Style="margin-bottom: 30px;"
                              Width="100%"
                              Items="@(OfficeColorUtilities.AllColors.Cast<OfficeColor?>())"
                              Height="200px"
                              @bind-SelectedOption="@OfficeColor">
                    <OptionTemplate>
                        <FluentStack>
                            <FluentIcon Value="@(new Icons.Filled.Size20.RectangleLandscape())"
                                        Color="Color.Custom"
                                        CustomColor="@GetCustomColor(@context)" />
                            <FluentLabel>@context</FluentLabel>
                        </FluentStack>
                    </OptionTemplate>
                </FluentSelect>
                @if (langOptions != null)
                {
                    <FluentSelect Label="@Localer["语言"]" Items=@langOptions
                                  OptionText="@(i => i.Text)"
                                  OptionValue="@(i => i.Value)"
                                  OptionSelected="@(i => i.Selected)"
                                  Width="100%"
                                  Style="margin-bottom: 30px;"
                                  @bind-Value="@lang" />
                }

                <FluentSwitch Label="@Localer["方向"]"
                              Style="margin-bottom: 30px;"
                              CheckedMessage="左至右"
                              UncheckedMessage="右至左"
                              Value="@_ltr"
                              ValueChanged="HandleDirectionChanged" />
               
                <FluentDivider Style="width: 100%; margin: 1rem 0" />
      

                <FluentStack VerticalAlignment="VerticalAlignment.Center">
                    <FluentButton OnClick="@ResetSiteAsync">@Localer["重置"]</FluentButton>
                </FluentStack>

                <p style="margin-top: 1rem;">
                    <em><strong>@_status</strong></em>
                </p>
            </FluentStack>
    
    </ContentPanel>

</FairdaoPage>
