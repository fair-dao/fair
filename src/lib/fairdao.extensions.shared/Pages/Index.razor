@*管理员以及代理首页*@
@page "/"
@page "/reload"
@using System.Globalization
@using System.Text

@inherits Page
<style>
	.fluent-appbar.smallicons {
	--appbar-item-size: 128;
	//58
	}

	.fluent-appbar {
		justify-content: space-evenly !important;
	}
</style>

<div class="fairdao-comtab">
	@if (CurTab != null)
	{
		<DynamicComponent Type="@Type.GetType(CurTab.Link)"></DynamicComponent>
	}
</div>
<FluentStack>
	<div style="background-color: var(--neutral-layer-3); overflow: auto; resize:horizontal;width: 100%;">
		<FluentAppBar Orientation="Orientation.Horizontal" Style="@(" background-color: var(--neutral-layer-2);")">
			@if (MTabs != null)
			{
				foreach (var topMenu in MTabs)
				{
					<FluentAppBarItem IconRest="@topMenu.Icon"
					IconActive="@topMenu.SelectedIcon"
					Tooltip="@Localer[topMenu.Text]"
					Href="@($"#{topMenu.Text}")"
									  Text="@Localer[topMenu.Text]" Count="@topMenu.Hots" Class="fairdao-comtabItem"
					OnClick="a=>TabChanged(topMenu)" />			
				}
			}
		</FluentAppBar>
	</div>
</FluentStack>
