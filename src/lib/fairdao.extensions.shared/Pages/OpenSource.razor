@inherits fairdao.extensions.shared.Pages.Page
<FairdaoPage ContentPadding>
    <TitlePanel>
        @Localer["开源组件"]
    </TitlePanel>
    <ContentPanel>

        <FluentMessageBar Title="提示">
            @Localer["以下是系统中用到的开源组件列表"]
        </FluentMessageBar>
        <FluentAccordion>
            <FluentAccordionItem>
                <HeadingTemplate>
                    FAIR DAO Framework
                </HeadingTemplate>
                <ChildContent>
                    fair dao framework
                    <div>
                        <a href="https://github.com/fair-dao/" target="_blank">开源地址</a>
                    </div>
                </ChildContent>
            </FluentAccordionItem>

            <FluentAccordionItem>
                <HeadingTemplate>
                    Fluent UI Blazor
                </HeadingTemplate>
                <ChildContent>
                    Microsoft Fluent UI Blazor components library. For use with ASP.NET Core Blazor applications
                    <div>
                        <a href="https://github.com/microsoft/fluentui-blazor" target="_blank">开源地址</a>
                        <a href="https://www.fluentui-blazor.net/" target="_blank">演示地址</a>
                    </div>
                </ChildContent>
            </FluentAccordionItem>
        </FluentAccordion>
    </ContentPanel>
</FairdaoPage>

