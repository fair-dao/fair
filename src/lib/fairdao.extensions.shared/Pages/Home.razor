@inherits Page
<FluentLayout>
    <FluentHeader Class="siteheader">
        <a href="/" aria-label="Back to the homepage">
            <div class="logo" role="presentation" aria-hidden="true" itemprop="logo" itemscope="itemscope">
                @((MarkupString)Extender.Logo)
            </div>
        </a>
        <FluentSpacer />



        <FluentIcon Value="@(new Icons.Regular.Size20.ScanDash())" Color="Color.Fill" @onclick="()=>scanning=true" />
        <NotificationCenter />

        @if (sysHelper.ClientConfig?.Tools != null)
        {

            foreach (shared.entity.VCommpent tool in sysHelper.ClientConfig.Tools)
            {
                <FluentIcon Value="@tool.Icon" Color="Color.Fill"  @onclick="()=> ComponentClick(tool)" />
            }
        }
        @if (sysHelper.ClientConfig?.MTabs != null)
        {

            foreach (shared.entity.VCommpent tab in sysHelper.ClientConfig.MTabs)
            {
                if (tab.Id != fairdao.extensions.shared.entity.SysMenuIds.HOME && tab.Id != fairdao.extensions.shared.entity.SysMenuIds.ME)
                {
                    <FluentIcon Class="fairdao-mobi-hide" Value="@tab.Icon" Color="Color.Fill" @onclick="()=>navManager.NavigateTo(GetLinkUrl(tab))" />
                }
            }
        }

    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <ErrorBoundary>
                <ChildContent>

                    @if (string.IsNullOrEmpty(scanResult))
                    {
                        <FairdaoSubComponent ComType="(int)ComponentType.IconMode" ParentId="home"></FairdaoSubComponent>
                    }
                    else
                    {
                        <div>
                            @Localer["无法识别的信息"]
                        </div>

                        <div>
                            @scanResult
                        </div>
                    }

                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="blazor-error-boundary">@ex.Message</div>
                </ErrorContent>
            </ErrorBoundary>
        </FluentBodyContent>
    </FluentStack>

    <FluentFooter>
        @Extender.CopyRight
        <FluentSpacer />
        @Extender.Version
    </FluentFooter>

</FluentLayout>
<UQRScaner FoundCode="QRFoundCode" @bind-Scanning="@scanning"></UQRScaner>

@code {
    public fairdao.extensions.shared.entity.VCommpent home = null;
    bool scanning { get; set; }

    /// <summary>
    /// 未处理的扫描结果
    /// </summary>
    string scanResult { get; set; }


    void QRFoundCode(object obj, string code)
    {
        scanning = false;
        if (code != null)
        {
            Toast(code);
            if (code.StartsWith("/")) //内部网址
            {
                Nav(code);
                return;
            }
            else if (code.StartsWith("{"))
            { //json对象

            }
            else
            if (code.StartsWith("https://"))
            { //外部网址
                Confirm(Localer["外部跳转"], Localer["是否打开"] + code + "?", () =>
                {
                    Nav(code);
                });
            }
            else if (code.StartsWith("fair:")) //插件
            {

            }
            else
            {
                scanResult = code;
            }
        }
        this.InvokeAsync(() => StateHasChanged());
    }


    protected override async Task OnInitializedAsync()
    {
        home = sysHelper.ClientConfig.MTabs.FirstOrDefault(m => m.Id == "home");

    }

    void ToSearch()
    {
        Nav("/Search");
    }
}
