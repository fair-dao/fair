@namespace fair.ui
<NavLink class="column is-4-mobile is-3-tablet is-2-widescreen is-1-fullhd"  href="@Nav" @onclick=@NavClicked>
    <UIcon Icon="@Icon" IconType="@IconType" Size="fair.ui.FontSize.Size2" IconColor="@IconColor"></UIcon>
    <div class="title">@Title</div>
</NavLink>
@code {





    [Parameter]
    public string Title { get; set; }
    /// <summary>
    /// 图标
    /// </summary>
    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public IconType IconType{ get; set; }

    [Parameter]
    public string IconColor { get; set; } = "blue";

    [Parameter]
    public string Nav { get; set; }



    [Parameter]
    public EventHandler Clicked { get; set; }

    void NavClicked()
    {

        if (Clicked!=null)
        {
            Clicked(null, EventArgs.Empty);
        }
    }

}
