@namespace fair.ui
<nav class="navbar@(IsToolbar? " com-toolbar":"")" @attributes="Attributes" com-auto="@ComAuto">
    <div class="navbar-brand">
        @if (!string.IsNullOrEmpty(BackUrl))
        {

            <div class="navbar-item">
                <UIcon Icon="left" @onclick="Back"></UIcon>
            </div>

        }


        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="navbar-item" style="flex:auto;">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <div class="navbar-face">
                        @if (Icon.StartsWith('/'))
                        {
                            <img src="@Icon" />
                        }
                        else
                        {

                            <i class="@Icon"></i>
                        }
                    </div>
                }
                <div class="navbar-title">
                    @((MarkupString)Title)
                    @if (!String.IsNullOrWhiteSpace(SubTitle))
                    {
                        <div class="nav-subtitle">
                            @SubTitle
                        </div>
                    }

                </div>


            </div>
        }


        @if (BrandLeft != null)
        {
            @BrandLeft
        }
        @if (BrandRight != null)
        {
            <div class="navbar-right">
                @BrandRight
            </div>
        }

        @if (MenuStart != null || MenuEnd != null)
        {
            <div class="navbar-burger burger">
                <i class="icon-ic_fluent_more_vertical_20_regular" @onclick="ToggleNavMenu"></i>
            </div>
        }
    </div>

    @if (MenuStart != null || MenuEnd != null)
    {
        <div class="navbar-menu @NavMenuCssClass">
            <div class="navbar-start">
                @MenuStart
            </div>
            <div class="navbar-end">
                @MenuEnd
            </div>
        </div>
    }
</nav>
@code {


    void Back()
    {

        this.jsRuntime.InvokeVoidAsync("window.back");

    }
    /// <summary>
    /// 回退地址，没有回退地址则不显示 回退按钮
    /// </summary>
    [Parameter]
    public string BackUrl
    {
        get
        {

            if (backUrl == null)
            {
                if (IsToolbar)
                {
                    backUrl = "";
                }
                else
                {
                    backUrl = "back";
                }
            }
            return backUrl;

        }
        set
        {
            backUrl = value;

        }
    }

    /// <summary>
    /// 顶部图标
    /// </summary>
    [Parameter]
    public string Icon { get; set; }

    /// <summary>
    /// 顶部标题
    /// </summary>
    [Parameter]
    public string Title { get; set; }




    [Parameter]
    /// <summary>
    /// 右侧操作按钮组（ 手机和电脑上始终都显示的项)
    /// </summary>
    public RenderFragment BrandRight { get; set; }

    /// <summary>
    /// 标题内容
    /// </summary>
    [Parameter]
    public string SubTitle { get; set; }

    /// <summary>
    /// 手机和电脑上始终都显示的项
    /// </summary>
    [Parameter]
    public RenderFragment BrandLeft { get; set; }

    private string backUrl;

    /// <summary>
    /// 是否为工具栏
    /// </summary>
    [Parameter]
    public bool IsToolbar { get; set; } = false;

    [Parameter]
    public RenderFragment Brand { get; set; }
    /// <summary>
    /// 附加属性
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Attributes { get; set; }


    [Parameter]
    public string ComAuto { get; set; }

    private string NavMenuCssClass => collapseNavMenu ? "is-active" : null;



    private bool collapseNavMenu = false;


    public void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }







    /// <summary>
    ///
    /// </summary>
    [Parameter]
    public RenderFragment MenuStart { get; set; }




    /// <summary>
    ///
    /// </summary>
    [Parameter]
    public RenderFragment MenuEnd { get; set; }



}
