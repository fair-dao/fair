@namespace fair.ui
@inherits UIBase
<div class="com-item">
    <div class="left">
        <i class="@Icon" style="color:@IconColor"></i>
    </div>
    <div class="mid">
    <input id="@Name" type="checkbox" name="@Name" class="switch is-rounded" checked="@Checked"
           @onchange="OnValueChanged">
    <label class="label" for="@Name">
        @(Checked ? CheckedMessage : UnCheckedMessage)
    </label>
    </div>

</div>
@code {



    /// <summary>
    /// 父容器
    /// </summary>
    [CascadingParameter]
    public UList Container { get; set; }

    /// <summary>
    /// 图标
    /// </summary>
    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public string IconColor { get; set; } = "blue";

    public HttpMethod Method { get; set; } = HttpMethod.Put;

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }




    Task OnValueChanged(ChangeEventArgs e)
    {
        bool value = (bool)e.Value;


        return this.httpClient.With(this.ThrowException).SubmitResult(SetUrl, $"{Name}={value}", Method).ContinueWith(e =>
        {
            Checked = value;
            if (CheckedChanged.HasDelegate)
            {
                    this.InvokeAsync(() =>
                    {
                        CheckedChanged.InvokeAsync(value);
                    });
             
           }
       });

    }

    /// <summary>
    /// 是否选中
    /// </summary>
    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public string Name { get; set; }


    [Parameter]
    public string SetUrl { get; set; }

    /// <summary>
    /// 选中的提示信息
    /// </summary>
    [Parameter]
    public string CheckedMessage { get; set; }

    /// <summary>
    /// 未选中的提示信息
    /// </summary>
    [Parameter]
    public string UnCheckedMessage { get; set; }

}
