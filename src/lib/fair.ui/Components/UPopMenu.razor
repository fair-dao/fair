@namespace fair.ui
@inherits UIBase

<div @attributes="Attributes" class="@classes" style="left:@(Left)px;top:@(Top)px;" @ref="el" @onclick="Hide">
    @ChildContent
</div>

@code {

    string classes => CssBuilder.Default("com-popmenu")
        .AddClassFromAttributes(Attributes)
        .AddClass("is-active", IsActive)
        .Build();

    [Parameter]
    public bool IsActive { get; set; } = false;

    [Parameter]
    public RenderFragment ChildContent { get; set; }


    public ElementReference el;

    public int Left { get; set; } = 0;
    public int Top { get; set; } = 0;


    public void Hide()
    {
        this.IsActive = false;
        StateHasChanged();
    }

    /// <summary>
    /// 显示菜单
    /// </summary>
    /// <param name="x"></param>
    /// <param name="y"></param>
    public void Show(MouseEventArgs e)
    {
        if (IsActive)
        {
            IsActive = false;
             this.InvokeAsync(() => StateHasChanged());
            return;
        }
        jsRuntime.InvokeAsync<double[]>("fair.ui.GetElementPoint", el).AsTask().ContinueWith(t =>
        {

            var point = t.Result;
            double swidth = point[0]-6;
            double sheight = point[1];
            double width = point[4];
            double height = point[5];
            //获取触发事件元素的左、顶坐标
            double left = e.ClientX - e.OffsetX;
            double top = e.ClientY - e.OffsetY;
            if (left + width > swidth)
            {
                Left = (int)(swidth - width);

            }
            else Left = (int)left;

            double y = top + 32; //52为点击图标的高度
            if (y + height >sheight)
            {
                Top = (int)(top - height);

            }
            else Top = (int)y;

            IsActive = true;
            this.InvokeAsync(() => StateHasChanged());

        });




    }
}
