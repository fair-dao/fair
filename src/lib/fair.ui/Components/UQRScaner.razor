@namespace fair.ui
@inherits UIBase
<div class="ui-scanner">
    <video id="scan_video" muted autoplay playsInline></video>

    <div class="ui-scaner-cancel">
        <UIcon Icon="back" @onclick="e=>ToBack()" IsBordered></UIcon>
     </div>
 </div>

 @code {
    IJSObjectReference pageObj;
    DotNetObjectReference<UQRScaner> thisPage;

    [Parameter]
    public bool Scanning
    {
        set
        {
            scanning = value;
            StateHasChanged();
            if (scanning)
            {
                pageObj.InvokeVoidAsync("Scan.init", thisPage);
            }
            else
            {

                pageObj?.InvokeVoidAsync("Scan.stop");
            }
        }
        get
        {
            return scanning;
        }
    }


    private bool scanning = false;
    public void Scan()
    {
        scanning = true;
    }

    [Parameter]
    public EventHandler<string> FoundCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        jsRuntime.InvokeVoidAsync($"window.history.replaceState", "back", null, "/");
        thisPage = DotNetObjectReference.Create(this);
        pageObj = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "/_content/fair.ui/js/scaner.js");

    }

    async void ToBack()
    {
        scanning = false;
        FoundCode.Invoke(this, null);

    }

    protected override ValueTask DisposeAsync(bool disposing)
    {
        scanning = false;
        try
        {
            pageObj?.InvokeVoidAsync("Scan.stop");
            thisPage?.Dispose();
            pageObj?.DisposeAsync();
        }
        catch (Exception e)
        {
            Console.WriteLine("出错{0}",e);
        }
        return base.DisposeAsync(disposing);
    }



    [JSInvokable]
    public async Task ProcessScan(string code)
    {
        scanning = false;
        Console.WriteLine($"扫到了：{code}");
        FoundCode.Invoke(this, code);

    }


}
