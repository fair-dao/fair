@inherits UIBase
@namespace fair.ui
<div class="@classes" @attributes="Attributes">
    @ChildContent
</div>

@code {

    private string classes => CssBuilder.Default("column")
      .AddClassFromAttributes(Attributes)
      .AddClass($"is-{Mobile}-mobile")
           .AddClass($"is-{Tablet}-tablet")
                .AddClass($"is-{WideScreen}-widescreen")
                     .AddClass($"is-{Fullhd}-fullhd")
      .Build();

    [Parameter]
    /// <summary>
    /// 手机每格宽度（一行总宽度为12）
    /// </summary>
    public int Mobile { get; set; } = 4;


    [Parameter]
    /// <summary>
    /// 平板每格宽度（一行总宽度为12）
    /// </summary>
    public int Tablet { get; set; } = 3;
    [Parameter]
    /// <summary>
    /// 宽屏每格宽度（一行总宽度为12）
    /// </summary>
    public int WideScreen { get; set; } = 2;

    [Parameter]
    /// <summary>
    /// 大屏每格宽度（一行总宽度为12）
    /// </summary>
    public int Fullhd { get; set; } = 1;


    [Parameter]
    public RenderFragment ChildContent { get; set; }


}
