@*通知中心组件,用于显示页面所有通知信息,将组件放置Layout页*@
@namespace fair.ui
@inherits UIBase
@implements IDisposable
@foreach (Guid s in UIBase.Notifications.Keys)
{
   
    @UIBase.Notifications[s]
}



@code {
    protected override Task OnInitializedAsync()
    {
        UIBase.NotificationsChanged += new EventHandler(NotificationsChanged);
        return base.OnInitializedAsync();
    }


    void NotificationsChanged(object a, EventArgs e)
    {
        this.StateHasChanged();
    }
   


    public void Dispose()
    {
        UIBase.NotificationsChanged -= new EventHandler(NotificationsChanged);
    }


}