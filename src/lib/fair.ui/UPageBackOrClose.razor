@namespace fair.ui
@if (BackMode)
{
    <i class="icon-ic_fluent_chevron_left_20_regular" style="display:inline-block; width:3.25rem;font-size:1.8rem;text-align:center;" @onclick="Back"></i>
}
else
{
    <i class="ri-close-circle-line com-close com-close-bottom" @onclick="Close"></i>
}
@code {


    [Parameter]
    public bool BackMode { get; set; } = true;

    /// <summary>
    /// 是否刷新父页面,默认不刷新
    /// </summary>
    [Parameter]
    public bool Flush { get; set; } = false;



    void Close()
    {
        this.jsRuntime.InvokeVoidAsync($"window.history.{(Flush ? "go" : "back")}", -1);

    }

    async Task Back()
    {
        await this.jsRuntime.InvokeVoidAsync("window.back");

    }
}
