@namespace fair.ui
@inherits FormItem<string>
<div class="field">
    <input id="@Name" type="checkbox" name="@Name" @attributes="Attributes" class="switch is-rounded"
                       @onchange="OnValueChanged"  >
    <label class="label" for="@Name">
        @(Checked=="True" ? CheckedMessage : UnCheckedMessage)
    </label>

</div>
@code {


    /// <summary>
    /// 是否选中
    /// </summary>
    [Parameter]
    public string Checked { get; set; }




    /// <summary>
    /// 左图标
    /// </summary>
    [Parameter]
    public string LeftIcon { get; set; }



    string hasLeftInfo = null;

    /// <summary>
    /// 选中的提示信息
    /// </summary>
    [Parameter]
    public string CheckedMessage { get; set; }

    /// <summary>
    /// 未选中的提示信息
    /// </summary>
    [Parameter]
    public string UnCheckedMessage { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if (Container!=null)   Container.SubmitData[this.Name] =Checked;

        if (Checked == "True")
        {
            if (this.Attributes==null)
            {
                this.Attributes = new Dictionary<string, object>();
            }
            this.Attributes.Add("checked", "checked");
        }
        if (!string.IsNullOrEmpty(LeftIcon))
        {
            hasLeftInfo = " has-icons-left";
        }
        if (UnCheckedMessage == null)
        {
            UnCheckedMessage = CheckedMessage;
        }

    }

    /// <summary>
    /// 传回父组件
    /// </summary>
    /// <param name="e"></param>
    /// <returns></returns>
    public  override void OnValueChanged(ChangeEventArgs e)
    {
        Console.WriteLine($"checked:{e.Value}");
        Checked=e.Value.ToString();
         base.OnValueChanged(e);
       
    }


}
