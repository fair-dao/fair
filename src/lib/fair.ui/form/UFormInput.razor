@namespace fair.ui
@inherits FormItem<string>
<div class="field">
    @if (Label != null)
    {
        <label class="label">
            @Label@if (!VailPassed && (Value != "" || Container.SubmitClicked))
            {
                <span class="help is-danger" style="display:inline-block;margin-left:0.5rem;margin-top:0rem;">@ErrMsg</span>
            }
    </label>}<div class="control @hasLeftInfo  has-icons-right">

        @if (Type == "textarea")
        {
            <textarea rows="6" class="textarea" placeholder="@Placeholder" name="@Name" @attributes="Attributes" @onchange="OnValueChanged">@Value</textarea>
        }
        else
        {
            <input @attributes="Attributes" class="input @(Value=="" && Container!=null && !Container.SubmitClicked ? "" :( VailPassed  ? "is-success":"is-danger"))" name="@Name" type="@Type" @oninput="@CheckValue"
                   placeholder="@Placeholder" value="@Value" @onchange="OnValueChanged">

            @if (!string.IsNullOrEmpty(LeftIcon))
            {
                <iconpark-icon name="@LeftIcon" class="icon is-small is-left"></iconpark-icon>
            }
            @if (!string.IsNullOrEmpty(RightIcon))
            {

                <iconpark-icon name="@RightIcon" class="icon is-small is-right" style="pointer-events:auto;" @onclick="RightIcon_Click"></iconpark-icon>
            }

            @if (VailPassed && string.IsNullOrEmpty(RightIcon))
            {

                <iconpark-icon name="check-one" class="icon is-small is-right" style="color:#48c774"></iconpark-icon>

            }
        }
    </div>

</div>
@code {


    /// <summary>
    /// 没填数据显示的信息和出错时的提示信息，中间用“,”隔开，如(1~3个汉字,请输入1~3个汉字）
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; }


    /// <summary>
    /// 出错提示信息
    /// </summary>
    [Parameter]
    public string ErrMsg { get; set; }
    /// <summary>
    /// 必须的
    /// </summary>
    [Parameter]
    public bool Required { get; set; } = false;


    /// <summary>
    /// 值
    /// </summary>
    [Parameter]
    public string Value { get; set; } = "";



    /// <summary>
    /// 左图标
    /// </summary>
    [Parameter]
    public string LeftIcon { get; set; }



    /// <summary>
    /// 左图标
    /// </summary>
    [Parameter]
    public string RightIcon { get; set; }

    [Parameter]
    public EventHandler<string> RightClick { get; set; }


    /// <summary>
    /// 输入框类型
    /// </summary>
    [Parameter]
    public string Type { get; set; }

    /// <summary>
    /// 正则验证
    /// </summary>
    [Parameter]
    public string Vail { get; set; }



    string hasLeftInfo = null;

    string hasRightInfo = null;


    string strState = "success";


    void RightIcon_Click()
    {
        RightClick?.Invoke(this, Value);
    }


    /// <summary>
    /// 检测是否通过
    /// </summary>
    [Parameter]
    public bool VailPassed { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        //    if (IsReadOnly)
        //    {
        //        Attributes.Add("readonly","readonly");
        //    }


        object val = Value;
        if (Type != null && (Type.IndexOf("date") >= 0))
        {
            val = DateTime.Parse(Value);
        }
        if (!String.IsNullOrEmpty(this.Name))
        {
            SetContainerValue(this.Name, val);
        }


        if (!string.IsNullOrEmpty(LeftIcon))
        { // has-icons-right
            hasLeftInfo = " has-icons-left";
        }
        Placeholder ??= string.Empty;
        int idx = Placeholder.IndexOf(",");
        if (string.IsNullOrWhiteSpace(ErrMsg))
        {
            if (idx > 0)
            {
                ErrMsg = Placeholder.Substring(idx + 1);
                Placeholder = Placeholder.Substring(0, idx);

            }
            else
            {
                ErrMsg = Placeholder;
            }
        }
        CheckVal();

    }


    void CheckValue(ChangeEventArgs e)
    {
        Value = e.Value.ToString();
        CheckVal();
    }

    /// <summary>
    /// 传回父组件
    /// </summary>
    /// <param name="e"></param>
    /// <returns></returns>
    public override void OnValueChanged(ChangeEventArgs e)
    {
        Value = e.Value.ToString();
        CheckVal();
        if (Type != null && (Type.IndexOf("date") >= 0)) //日期类型数据只传UTC时间
        {
            DateTime t = DateTime.Parse(Value);
            e.Value = t;
        }
        base.OnValueChanged(e);

    }

    void CheckVal()
    {
        if (string.IsNullOrEmpty(Value))
        {
            if (Required)
            {
                VailPassed = false;

            }
            else VailPassed = true;

        }
        else
        {
            if (!string.IsNullOrEmpty(Vail))
            {

                if (System.Text.RegularExpressions.Regex.IsMatch(Value, Vail))
                {
                    VailPassed = true;
                }
                else
                {
                    VailPassed = false;
                }
            }
            else
            {
                VailPassed = true;
            }
        }

        if (Container != null)
        {
            string vailKey = this.Name ?? this.Label;
            if (VailPassed)
            {
         
                if (this.Container.ErrList.ContainsKey(vailKey))
                {
                    this.Container.ErrList.Remove(vailKey);
                }
            }
            else
            {
                if (!this.Container.ErrList.ContainsKey(vailKey))
                {
                    this.Container.ErrList.Add(vailKey, ErrMsg);
                }

            }
        }
        StateHasChanged();

    }


}
