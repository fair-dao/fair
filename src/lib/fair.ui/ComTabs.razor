
<div @ref="TabElement">
    @ActiveComTab?.ChildContent
</div>

<CascadingValue Value=this>
    <nav class="com-tabs"  style="@(AlwaysShow?"display:inline-flex":"")" >@ChildContent</nav>
</CascadingValue>

@code {

    public ElementReference TabElement { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    string BaseUrl { get; set; }

    public ComTab ActiveComTab { get; private set; }


    [Parameter]
    public bool AlwaysShow{get;set;}=false;


    public void AddTab(ComTab tab)
    {
        if (ActiveComTab == null)
        {
            SetActivateTab(tab);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        try
        {
            jsRuntime.InvokeVoidAsync("com.auto.init", TabElement);
        }
        catch { }
    }


    protected override void OnInitialized()
    {
        base.OnInitialized();

        Uri uri = new Uri(navManager.Uri);
        BaseUrl = uri.PathAndQuery;

    }

    public void RemoveTab(ComTab tab)
    {
        if (ActiveComTab == tab)
        {
            SetActivateTab(null);
        }
    }

    public void SetActivateTab(ComTab tab)
    {

        if (ActiveComTab != tab)
        {
            if (ActiveComTab!=null) ActiveComTab.IconState = "";
            tab.IconState = "-fill";
            ActiveComTab = tab;
            try
            {
                jsRuntime.InvokeVoidAsync("window.history.replaceState", tab.Title, tab.Title, BaseUrl + "#" + tab.Title);
            }catch{}
        if (tab.Clicked!=null)
            {
                tab.Clicked(tab, EventArgs.Empty);
            }
            StateHasChanged();

        }
    }

}
