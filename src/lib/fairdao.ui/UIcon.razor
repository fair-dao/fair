@namespace fairdao.ui
@if (IsShow)
{
    <div @attributes="Attributes" class="@classes" title="@Title">

        <div class="ui-icon-ico">
            @if (Icon!=null && Icon.StartsWith("/"))
            {
                <img src="@Icon" />
            }
            else
            {
                <iconpark-icon name="@Icon" color="@(!string.IsNullOrEmpty(IconColor) ? $"{IconColor}":"")"></iconpark-icon>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Text))
        {
            <div class="ui-icon-text @(PhoneHideText ? "hide800":"")">@Text</div>
        }



        @if (Mark > 0)
        {
            <span class="hots">@Mark</span>
        }

    </div>
}
@code {
    /// <summary>
    /// 类
    /// </summary>
    string classes => CssBuilder.Default("ui-icon")
        .AddClassFromAttributes(Attributes)
          .AddClass("is-round", IsBordered)
          .AddClass("inline", Inline)
          .AddClass(Size?.ToString(), Size.ToString())
        .Build();

    /// <summary>
    /// 是否显示
    /// </summary>
    [Parameter]
    public bool IsShow { get; set; } = true;


    [Parameter]
    public string Title { get; set; }

    /// <summary>
    /// 小屏隐藏图标文字
    /// </summary>
    [Parameter]
    public bool PhoneHideText { get; set; } = false;


    /// <summary>
    /// 角标
    /// </summary>
    [Parameter]
    public int Mark { get; set; } = 0;

    [Parameter]
    public bool IsBordered { get; set; } = false;

    [Parameter]
    public FontSize Size { get; set; } = new FontSize(null);

    /// <summary>
    /// 附加属性
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Attributes { get; set; }

    [Parameter]
    public IconType IconType { get; set; }

    private string icon;

    /// <summary>
    /// icon 类名
    /// </summary>
    [Parameter]
    public string Icon
    {
        get
        {
            if (string.IsNullOrEmpty(icon))
            {
                switch (IconType)
                {
                    case IconType.Create:
                        icon = "add";
                        break;
                    case IconType.Edit:
                        icon = "editor";
                        break;
                    case  IconType.ScanCode:
                        icon = "scan-code";
                        break;
                    case IconType.More:
                        icon = "more-two";
                        break;
                    case IconType.Cancel:
                        icon = "delete";
                        break;
                    case IconType.Buy:
                        icon = "payment-method";
                        break;
                    default:
                        if (IconType != IconType.Unknown)
                        {
                            icon = IconType.ToString().ToLower();
                        }
                        break;
                }


            }

            return icon;
        }
        set
        {
            icon = value;
        }
    }
    /// <summary>
    /// 文本
    /// </summary>
    [Parameter]
    public string Text { get; set; }

    /// <summary>
    /// 文字和图标是否显示在一行
    /// </summary>
    [Parameter]
    public bool Inline { get; set; } = true;

    [Parameter]
    public string IconColor { get; set; }


}
