@namespace fairdao.ui
<div class="com-sidebar-item has-dropdown  @(IsActived==true?" is-active":"")">
    <a class="com-sidebar-link" @onclick="() => IsActivedChanged.InvokeAsync(IsActived!=true)">
        <UIcon Icon="@Icon" Text="@Text" IconColor="@IconColor"></UIcon><UIcon class="right" Icon="left"></UIcon>
    </a>
    <div class="com-sidebar-dropdown">
        @*下拉菜单*@
        <CascadingValue Value=this IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
</div>



@code {

    [CascadingParameter]
    public USidebarMenu Container { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public string Text { get; set; }
    [Parameter]
    public bool? IsActived { get; set; } = false;

    [Parameter]
    public string IconColor { get; set; }



    [Parameter]
    public EventCallback<bool?> IsActivedChanged { get; set; }




}
