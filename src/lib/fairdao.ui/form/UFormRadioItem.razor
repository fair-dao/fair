@namespace fairdao.ui
@inherits FormItem<string>
<input id="@Id" type="radio" class="is-checkradio" @attributes="Attributes" name="@Name" value="@Value"
       checked="@Selected" @onclick="@(()=>RadioClicked(Value))"><label class="radio" for="@Id">@ChildContent</label>

@code {



    [Parameter]
    public bool Selected { get; set; } = false;


    [Parameter]
    public EventCallback<string> Clicked{ get; set; }


    /// <summary>
    /// 父容器
    /// </summary>
    [CascadingParameter]
    public UFormRadio RadioContainer { get; set; }



    private Guid? id;
    Guid Id
    {
        get
        {
            if (id == null)
            {
                id = Guid.NewGuid();

            }
            return id.Value;
        }
    }


    void RadioClicked(string value)
    {

        if (Container != null && !string.IsNullOrEmpty(Name))
        {
            Container.SubmitData[this.Name] = value;
        }
        if (RadioContainer != null)
        {
            RadioContainer.Radio_Clicked(value);
        }
        if (Clicked.HasDelegate)
        {
            Clicked.InvokeAsync(value);
        }
    }

    [Parameter]
    public string Value { get; set; }



    [Parameter]
    public RenderFragment ChildContent { get; set; }



    protected override Task OnInitializedAsync()
    {

        if (RadioContainer != null)
        {
            if (string.IsNullOrEmpty(Name)) Name = RadioContainer.Name;
            Selected = (Value == RadioContainer.SelectValue);
          
        }
        
           if(Selected)  SetContainerValue(this.Name, Value);
         
        return base.OnInitializedAsync();
    }
}
