@page "/fair/sysInfo"
@using System.Diagnostics
@using System.Reflection
@inherits fairdao.extensions.main.Pages.Page
<UPage ContentPadding>
    <TitlePanel>
        @Localer["软件信息"]
    </TitlePanel>
    <TabPanel>
        <ComTab Title="@Localer["核心组件"]">
            <UPage ContentPadding>
                <ContentPanel>
                    @if (cores.Count > 0)
                    {
                        @foreach (var a in cores.Keys)
                        {
                            <Card>
                                <CardHeader>@a</CardHeader>
                                    <CardContent>
                                        <div>全称：@cores[a].Name </div>
                                    <div>版本：@cores[a].Ver</div>
                                    <div>开发者：@cores[a].Company</div>
                                </CardContent>
                            </Card>
                            <br />
                        }
                    }
                </ContentPanel>
            </UPage>
        </ComTab>
        <ComTab Title="@Localer["扩展组件"]">
      
                    <UPage ContentPadding>
                        <ContentPanel>
                            @if (exts.Count > 0)
                            {
                                @foreach (var a in exts.Keys)
                                {
                                    <Card>
                                        <CardHeader>@a</CardHeader>
                                            <CardContent>
                                                <div>全称：@exts[a].Name </div>
                                            <div>版本：@exts[a].Ver</div>
                                            <div>开发者：@exts[a].Company</div>
                                        </CardContent>
                                    </Card>
                                    <br />
                                }
                            }
                        </ContentPanel>
                    </UPage>
            
        </ComTab>
    </TabPanel>
</UPage>

@code {
    Dictionary<string, AsmData> cores = new ();

    Dictionary<string, AsmData> exts = new();
    protected override void OnInitialized()
    {
        System.Reflection.Assembly main = SysHelper.EntryAssembly;
        cores.Add($"主程序", GetAsmData(main));
        System.Reflection.Assembly share = typeof(fairdao.extensions.shared.SysHelper).Assembly;
        cores.Add("扩展共享库", GetAsmData(share));

        int i = 0;
        foreach(var a in SysHelper.Extenders)
        {
            var ass = GetAsmData(a.GetType().Assembly);
            if (ass!=null)
            exts.Add($"{i++}.{a.Name}({a.Id})", ass);
        }

        base.OnInitialized();
    }

    record AsmData(string Name,string Ver,string Company);

    AsmData GetAsmData(System.Reflection.Assembly asm)
    {
        if (asm == null) return new AsmData("","","");
        string ver = "";
        string company = "";
        string name = "";
        foreach (var a in asm.CustomAttributes)
        {
            if (a.AttributeType == typeof( System.Reflection.AssemblyCompanyAttribute))
            {
                company = a.ConstructorArguments[0].ToString()?.Trim('\"');
                continue;
            }
            if (a.AttributeType == typeof(System.Reflection.AssemblyInformationalVersionAttribute))
            {
                ver = a.ConstructorArguments[0].ToString()?.Trim('\"');
                continue;
            }
            if (a.AttributeType == typeof(System.Reflection.AssemblyProductAttribute))
            {
                name = a.ConstructorArguments[0].ToString()?.Trim('\"');
                continue;
            }
        }
        return new AsmData(name, ver, company);
    }

}
