@namespace fairdao.ui
@inherits UIBase
<input @attributes="Attributes" @bind-value="@Value"  class="input @AttrClass" type="@pickerType"/>

@code {
    private string _value;
    [Parameter]
    public string Value
    {
        get => _value;
        set
        {
            if (_value == value ) return;
            _value = value;
            ValueChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<string> ValueChanged{ get; set; }

    /// <summary>
    /// 日期控件类型
    /// </summary>
    [Parameter]
    public DatePickerType PickerType { get; set; } = DatePickerType.Date;


    string pickerType => PickerType == DatePickerType.DateTime ? "datetime-local" : "date";

}
