@namespace fairdao.ui
@inherits UIBase
<div @attributes="Attributes" class="@this.classes">
    <a class="com-sidebar-link" @onclick="()=>this.Jmp()">
        <UIcon Icon="@this.Icon" IconColor="@IconColor" Text="@this.Text"></UIcon>
    </a>
</div>

@code {
    [CascadingParameter]
    public USidebar Sidebar { get; set; }

    /// <summary>
    /// 图标
    /// </summary>
    [Parameter]
    public string Icon { get; set; }
    [Parameter]
    public string Text { get; set; }
    [Parameter]
    public string Url { get; set; }
    [Parameter]
    public string IconColor { get; set; }

    public string classes => CssBuilder.Default("com-sidebar-item").AddClassFromAttributes(Attributes).Build();

    void Jmp()
    {
        if (!string.IsNullOrEmpty(Url))
        {
            navManager.NavigateTo(Url);
        }

    }
}