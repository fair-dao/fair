@namespace fairdao.ui
  @if (isShow)
{
    <div class="com-search">
               <UNavbar BackUrl="">
            <BrandLeft>
                 @ChildContent
            
            </BrandLeft>
            <BrandRight>
                <UIcon IconType="IconType.Close" @onclick="e=>IsShowChanged.InvokeAsync(false)"></UIcon>
            </BrandRight>
        </UNavbar>
       
    </div> 
    }
@code {
    [Parameter]
    public RenderFragment ChildContent{ get; set; }


    bool isShow;
    [Parameter]
    public bool IsShow
    {
        get
        {
            return isShow;
        }
        set
        {
            isShow=value;
            Console.WriteLine($"ishow:{isShow}");
        }
    }
    [Parameter]
    public EventCallback<bool> IsShowChanged{ get; set; }
}
