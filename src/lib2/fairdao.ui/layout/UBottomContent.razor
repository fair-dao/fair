@namespace fairdao.ui
@inherits UIBase
@if (IsShow)
{
    <div @attributes="Attributes"  class="@classes">
        @ChildContent
    </div> 
}

@code {

    [Parameter]
    public bool IsShow { get; set; } = true;

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    
    /// <summary>
    /// 是否两边留1rem间隙
    /// </summary>
    [Parameter]
    public bool IsPadding { get; set; }

    
    /// <summary>
    /// 内容是否水平居中
    /// </summary>
    [Parameter]
    public bool IsCenter { get; set; }


    string classes => CssBuilder.Default("com-bcontent")
        .AddClassFromAttributes(Attributes)
        .AddClass("is-padding", IsPadding)
        .AddClass("is-center", IsCenter)
        .Build();

}
