@page "/Found"
@inherits Page

<UPage>
    <TitlePanel>
        @Localer["发现"]
    </TitlePanel>
    <ContentPanel>
        <UDesk>
            @if (MoreTabs != null)
            {
                if (MoreTabs.Count == 0)
                {
                    <UCenter Empty></UCenter>
                    
                }else{
                foreach (var topMenu in MoreTabs)
                {
                    if (topMenu.ShowMode == MenuShowModes.CommpentMode) //自定义组件
                    {
                        <UDeskItem Nav="@($"/base/Dypage/{topMenu.Link}")" Title="@Localer[topMenu.Text]" Icon="@topMenu.Icon" IconColor="@topMenu.IconColor"></UDeskItem>
                    }
                    else
                    {

                        <UDeskItem Nav="@topMenu.Link" Title="@Localer[topMenu.Text]" Icon="@topMenu.Icon" IconColor="@topMenu.IconColor"></UDeskItem>
                    }

                }
                }
            }
        </UDesk>
    </ContentPanel>
</UPage>
@code {

    public List<fairdao.extensions.shared.entity.VCommpent> MoreTabs = null;

    protected override async Task OnInitializedAsync()
    {
        MoreTabs = sysHelper.ClientConfig.MTabs.Skip(5).Take(1000).ToList();

    }


}
