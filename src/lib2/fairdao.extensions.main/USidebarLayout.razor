@inherits LayoutComponentBase
@inject fairdao.extensions.shared.SysHelper sysHelper;
@inject NavigationManager Nav
@implements IDisposable

<USidebar Icon="category-management" Title="@Localer["访达导航"]" Nav="/#home" NavTip="@Localer["访达导航"]">
    <USidebarMenu>
        <USidebarMenuSupItem Image="@AccountService?.GetProfilePhoto(curAccount)" Text="@(curAccount?.NickName??Localer["未登录"])" Url="@(AccountService?.LoginUrl??"#")"></USidebarMenuSupItem>
        @if (sidebarMenus != null)
        {
            foreach (var m in sidebarMenus)
            {

                if (m.SubMenus != null && m.SubMenus.Count > 0)
                {
                    <USidebarDownMenuItem Text="@Localer[m.Text]" Icon="@m.Icon" IconColor="@m.IconColor" @bind-IsActived="@m.Expand">
                        @foreach (var subMenu in m.SubMenus)
                        {
                            <UsidebarItem Text="@Localer[subMenu.Text]" Icon="@subMenu.Icon" Url="@subMenu.Link"></UsidebarItem>
                        }
                    </USidebarDownMenuItem>

                }
                else
                {
                    <UsidebarItem Text="@Localer[m.Text]" Icon="@m.Icon" Url="@m.Link"></UsidebarItem>
                }
            }
        }
    </USidebarMenu>
    <USidebarFooter>
        @if (sysHelper.LocalData != null && sysHelper.LocalData.Cultures.Count() > 1)
        {
            <UIcon Icon="international" Size="FontSize.Size5" IconColor="#35d3fa" Text="@CurLang?.NativeName" @onclick="e=>isV=true"></UIcon>
        }
        <UIcon Icon="power" Size="FontSize.Size5" IconColor="#FFF" Text="@Localer["线路"]" @onclick='ChangeLine'></UIcon>
    </USidebarFooter>
</USidebar>
<div class="com-main">
    @Body
</div>

<UNotificationCenter></UNotificationCenter>
<Dialog @ref="dialog"></Dialog>
@if (sysHelper.LocalData?.Cultures != null)
{
    <Modal @ref="m1" IsActive="isV" ShowClose="@false" style="text-align:center;">
        <Message>
            <HeaderSlot>
                <p>
                    @Localer["切换语言"]
                </p>
                <Delete @onclick="close"></Delete>
            </HeaderSlot>
            <BodySlot>
                <UList>
                    @foreach (var culture in sysHelper.LocalData.Cultures)
                    {
                        <UListItem Clicked="(e,b)=>changeLang(culture)" Title="@culture.NativeName">
                        </UListItem>
                    }
                </UList>

            </BodySlot>
        </Message>
    </Modal>
}

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />



@code {


    [Inject]
    fairdao.extensions.shared.services.TransService Trans { get; set; }


    BlockchainAccount curAccount;

    bool isV = false;
    Modal m1;

    void ChangeLine()
    {
        navManager.NavigateTo("/user/apiServer");
    }

    void ToLogin()
    {
        Nav.NavigateTo("/login");
    }



    async Task changeLang(Culture c)
    {
        await sysHelper.ChangeLang(Trans, Localer, c.Name);

        close();
        CurLang = await sysHelper.GetCurLang();
        //sysHelper.NavTo(sysHelper.NavManager.Uri, forceLoad: true);
        //Nav.NavigateTo("/gensys/loaded");
        StateHasChanged();

    }

    void close()
    {
        isV = false;
    }

    void Show()
    {
        isV = true; // or  m1.Show();
    }

    private List<fairdao.extensions.shared.entity.VCommpent> sidebarMenus = null;

    Dialog dialog;

    [Inject]
    IServiceProvider provider { get; set; }

    IAccountService AccountService;

    DateTime? ServerTime { get; set; }

    Culture CurLang { get; set; }
    protected override async Task OnInitializedAsync()
    {
        CurLang = await sysHelper.GetCurLang();
        AccountService = provider.GetService(typeof(IAccountService)) as IAccountService;
        if (AccountService != null)
        {
            curAccount = await AccountService.GetAccountAsync();
        }

        sysHelper.ConfigChanged += new SysHelper.ConfigChangedHandler(ConfigChanged);

        ConfigChanged();

        base.OnInitializedAsync();
        Console.WriteLine($"Usidelayout:{navManager.Uri}");

    }

    void ConfigChanged()
    {
        sidebarMenus = sysHelper.ClientConfig?.Sides;
        this.InvokeAsync(() => StateHasChanged());
    }
    public void Dispose()
    {
        sysHelper.ConfigChanged -= new SysHelper.ConfigChangedHandler(ConfigChanged);

    }

}


